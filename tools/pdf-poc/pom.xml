<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Banc d'essai PDF (ADR-13, etape 1 lot 4b). Projet autonome, hors de l'application :
      il ne sert qu'a comparer deux moteurs de rendu sur une facture FR et AR.
    -->
    <groupId>ma.agencysuite.tools</groupId>
    <artifactId>pdf-poc</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>AgencySuite - banc d'essai PDF</name>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <playwright.version>1.64.0</playwright.version>
        <openhtmltopdf.version>1.1.31</openhtmltopdf.version>
    </properties>

    <dependencies>
        <!-- Candidat 1 : Chromium sans interface, pilote par Playwright -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
        </dependency>

        <!-- Candidat 2 : openhtmltopdf (fork communautaire) + extension droite-a-gauche -->
        <dependency>
            <groupId>io.github.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-pdfbox</artifactId>
            <version>${openhtmltopdf.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-rtl-support</artifactId>
            <version>${openhtmltopdf.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>ma.agencysuite.tools.pdfpoc.PdfPoc</mainClass>
                    <systemProperties>
                        <systemProperty>
                            <key>poc.output</key>
                            <value>${project.build.directory}/pdf-poc</value>
                        </systemProperty>
                    </systemProperties>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
