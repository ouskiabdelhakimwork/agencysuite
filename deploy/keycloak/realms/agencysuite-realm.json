{
  "realm": "agencysuite",
  "enabled": true,
  "displayName": "AgencySuite",
  "internationalizationEnabled": true,
  "supportedLocales": ["fr", "ar", "en"],
  "defaultLocale": "fr",
  "organizationsEnabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "rememberMe": false,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@agencysuite.local",
    "fromDisplayName": "AgencySuite (local)"
  },
  "clients": [
    {
      "clientId": "agencysuite-frontend",
      "name": "AgencySuite - application web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      },
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "basic", "email", "organization"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"],
      "protocolMappers": [
        {
          "name": "agencysuite-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "agencysuite-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "agencysuite-dev-cli",
      "name": "DEV ONLY - jetons pour les controles manuels (curl)",
      "description": "DEV ONLY - client de developpement local (direct access grants). N'existe jamais en recette ni en production.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "basic", "email", "organization"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"],
      "protocolMappers": [
        {
          "name": "agencysuite-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "agencysuite-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
