{
  "realm": "platform",
  "enabled": true,
  "displayName": "AgencySuite - back-office editeur",
  "internationalizationEnabled": true,
  "supportedLocales": ["fr", "ar", "en"],
  "defaultLocale": "fr",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "passwordPolicy": "length(14) and notUsername and notEmail",
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10
    }
  ],
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@agencysuite.local",
    "fromDisplayName": "AgencySuite (local)"
  },
  "clients": [
    {
      "clientId": "agencysuite-backoffice",
      "name": "AgencySuite - back-office editeur",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      },
      "protocolMappers": [
        {
          "name": "agencysuite-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "agencysuite-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "agencysuite-dev-cli",
      "name": "DEV ONLY - jetons pour les controles manuels (curl)",
      "description": "DEV ONLY - client de developpement local (direct access grants). N'existe jamais en recette ni en production.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": [],
      "webOrigins": [],
      "protocolMappers": [
        {
          "name": "agencysuite-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "agencysuite-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
