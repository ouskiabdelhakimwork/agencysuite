# Variables de l'environnement LOCAL. Copier en .env (jamais versionne) et changer les mots de passe.
# Ne jamais reutiliser ces valeurs en recette ou en production.

POSTGRES_USER=agencysuite
POSTGRES_PASSWORD=change-me-local
KEYCLOAK_DB_PASSWORD=change-me-local

KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me-local

RABBITMQ_USER=agencysuite
RABBITMQ_PASSWORD=change-me-local

# Emetteurs des jetons Keycloak acceptes par le backend (adresses publiques, pas des secrets)
KEYCLOAK_AGENCY_ISSUER=http://localhost:8180/realms/agencysuite
KEYCLOAK_PLATFORM_ISSUER=http://localhost:8180/realms/platform

# Secret du compte de service Keycloak du backend (client agencysuite-backend, realm agencysuite),
# pour les invitations et la gestion des utilisateurs (etape 3, lot 5). Laisser VIDE ici : le copier
# depuis la console (Clients > agencysuite-backend > Credentials) dans deploy/.env uniquement.
# Vide : le backend demarre, les invitations repondent 503.
KEYCLOAK_BACKEND_CLIENT_SECRET=
